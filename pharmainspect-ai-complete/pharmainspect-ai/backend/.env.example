# TCS GenAI Lab integration
# Never commit a real API key.
TCS_AI_API_KEY=
TCS_AI_BASE_URL=https://genailab.tcs.in
TCS_AI_MODEL=azure_ai/genailab-maas-DeepSeek-V3-0324

# The AI Lab handbook sample disables certificate verification.
# Keep this false only inside the approved lab environment.
TCS_AI_VERIFY_SSL=false

# Image inspection configuration
PHARMA_GOOD_IMAGES_DIR=C:\path\to\approved\good
PHARMA_IMAGE_RELEVANCE_THRESHOLD=0.50
PHARMA_GOOD_IMAGE_THRESHOLD=0.90
